	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8e797f",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#8b7d84"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#db4d70",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.new",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#bf899b"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.unquoted",
				"string.quoted"
			],
			"settings": {
				"foreground": "#dcb592"
			}
		},
		{
			"name": "String Escape, Regexp",
			"scope": [
				"constant.character.escape",
				"string.regexp"
			],
			"settings": {
				"foreground": "#d3a77a"
