	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8a7d78",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#8b7f78"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#d9564a",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator",
				"keyword.operator.new",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#c98a72"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.unquoted",
				"string.quoted"
			],
			"settings": {
				"foreground": "#d6b98c"
			}
		},
		{
			"name": "String Escape, Regexp",
